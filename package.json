{
  "name": "punchpay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:payments": "node --test tests/*.test.mjs",
    "sandbox:create": "node --env-file=.env.local scripts/paypal-smoke.mjs create",
