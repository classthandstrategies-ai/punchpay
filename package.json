{
  "name": "punchpay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --no-warnings tests/*.test.mjs",
    "test:payments": "node --test --no-warnings tests/*.test.mjs",
    "sandbox:create": "node --env-file=.env.local scripts/paypal-smoke.mjs create",
    "sandbox:settle": "node --env-file=.env.local scripts/paypal-smoke.mjs settle",
    "sandbox:verify": "node --env-file=.env.local scripts/paypal-smoke.mjs verify",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@supabase/supabase-js": "^2.49.0",
