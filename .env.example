# ALL payments must remain sandbox for this hackathon build.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Obtain from the contractor sandbox Business account; compare to actual order payee.
PAYPAL_MERCHANT_ID=
# A personal sandbox payer approves each order in a browser.
# App origin for PayPal returns:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: use a DEDICATED project for PunchPay. Service role stays server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if enabling live AI review:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Credential-free demo path. Set to 1 ONLY when there is no ANTHROPIC_API_KEY: the app then records
# a review that states no model examined the photos (source: prototype_no_model) so the PayPal flow
# can be demonstrated end to end. It is never presented as analysis, it can never say the work looks
# satisfactory, and it is ignored whenever a real key is configured. Leave blank for live review.
PUNCHPAY_PROTOTYPE_REVIEW=

# Sandbox access gate (8+ chars each). NOT production authentication.
# Homeowner: approve holds, accept/reject. Contractor: upload photos, request review.
HOMEOWNER_PASSCODE=
CONTRACTOR_PASSCODE=
# Presenter passcode: acts as both roles for a single-screen demo.
DEMO_PASSCODE=
